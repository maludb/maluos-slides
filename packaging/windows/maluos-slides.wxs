<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="MaluOS Slides" Manufacturer="MaluOS" Version="$(var.Version)" UpgradeCode="6F9C69E7-7825-40D2-BF26-C274DA676425" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="MaluOS Slides presentations and slide shows" Manufacturer="MaluOS" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of MaluOS Slides is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="MaluOS SlidesIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="MaluOS SlidesIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/maludb/maluos-slides" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/maludb/maluos-slides" />
    <Property Id="ARPHELPLINK" Value="https://github.com/maludb/maluos-slides/discussions" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="ArtCraft">
        <Directory Id="INSTALLFOLDER" Name="MaluOS Slides" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="MaluOS Slides" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="MaluOS SlidesFiles" />
    </Feature>
  <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="MaluOS SlidesFiles" Directory="INSTALLFOLDER">
      <Component Id="MaluOS SlidesApp" Guid="D87EA444-41A4-4C19-922E-66D1A29461FF">
        <File Id="MaluOS SlidesNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="MaluOS SlidesExe" Source="$(var.BinDir)\maluos-slides.exe" KeyPath="yes">
          <!-- No Icon here, so the shortcut shows the icon embedded in maluos-slides.exe (build.rs). An
               MSI Icon is cached under %APPDATA%\Microsoft\Installer\{ProductCode}\, and every
               update is a major upgrade with a new ProductCode that deletes the old folder. A
               taskbar pin is a copy of this shortcut that the update never touches, so it kept
               pointing at the deleted file and lost its icon (#1114). The exe's path survives
               updates; the shortcut is not advertised, so it targets that path and its icon is the
               exe's own. The Icon above stays for ARPPRODUCTICON (Apps and features). -->
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="MaluOS Slides" Description="MaluOS Slides presentations and slide shows" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        </File>

        <!-- .deckcraft: the app's own format. -->
        <ProgId Id="MaluOS Slides.Presentation" Description="MaluOS Slides Presentation" Icon="MaluOS SlidesExe" IconIndex="0">
          <Extension Id="maluos-slides" ContentType="application/x-deckcraft">
            <Verb Id="open" Command="Open" TargetFile="MaluOS SlidesExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!-- "Open with" for PowerPoint formats, without becoming the default. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\maluos-slides.exe" Name="FriendlyAppName" Value="MaluOS Slides" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\maluos-slides.exe\shell\open\command" Value="&quot;[#MaluOS SlidesExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\maluos-slides.exe\SupportedTypes" Name=".deckcraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\maluos-slides.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\maluos-slides.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\maluos-slides.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pptx\OpenWithProgids" Name="MaluOS Slides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.potx\OpenWithProgids" Name="MaluOS Slides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ppsx\OpenWithProgids" Name="MaluOS Slides.Presentation" Value="" Type="string" />

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\maluos-slides.exe" Value="[#MaluOS SlidesExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\MaluOS Slides" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="MaluOS SlidesCli">
        <File Id="MaluOS SlidesCliExe" Source="$(var.BinDir)\maluos-slides-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
