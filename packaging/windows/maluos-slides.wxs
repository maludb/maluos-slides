<?xml version="1.0" encoding="utf-8"?>
<!--
  MaluOS Slides MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build maluos-slides.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.deckcraft` owned by
  MaluOS Slides, and MaluOS Slides offered under "Open with" for .pptx/.potx/.ppsx (without taking over
  the user's default app for them).

  UpgradeCode is fixed for MaluOS Slides forever (playbook §6); never change it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="MaluOS Slides"
      Manufacturer="MaluOS"
      Version="$(var.Version)"
      UpgradeCode="6F9C69E7-7825-40D2-BF26-C274DA676425"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="MaluOS Slides presentations and slide shows" Manufacturer="MaluOS" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of MaluOS Slides is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="MaluOS SlidesIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="MaluOS SlidesIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/maludb/maluos-slides" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/maludb/maluos-slides" />
    <Property Id="ARPHELPLINK" Value="https://github.com/maludb/maluos-slides/discussions" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="MaluOS Slides" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="MaluOS Slides" Level="1">
      <ComponentGroupRef Id="MaluOS SlidesFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="MaluOS SlidesFiles" Directory="INSTALLFOLDER">
      <Component Id="MaluOS SlidesApp" Guid="D87EA444-41A4-4C19-922E-66D1A29461FF">
        <File Id="MaluOS SlidesExe" Source="$(var.BinDir)\maluos-slides.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="MaluOS Slides"
              Description="MaluOS Slides presentations and slide shows" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="MaluOS SlidesIcon.ico" IconIndex="0" />
        </File>

        <!-- .deckcraft: the app's own format. -->
        <ProgId Id="MaluOS Slides.Presentation" Description="MaluOS Slides Presentation" Icon="MaluOS SlidesExe" IconIndex="0">
          <Extension Id="maluos-slides" ContentType="application/x-deckcraft">
            <Verb Id="open" Command="Open" TargetFile="MaluOS SlidesExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!-- "Open with" for PowerPoint formats, without becoming the default. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\maluos-slides.exe" Name="FriendlyAppName" Value="MaluOS Slides" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\maluos-slides.exe\shell\open\command" Value="&quot;[#MaluOS SlidesExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\maluos-slides.exe\SupportedTypes" Name=".deckcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\maluos-slides.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\maluos-slides.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\maluos-slides.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pptx\OpenWithProgids" Name="MaluOS Slides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.potx\OpenWithProgids" Name="MaluOS Slides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ppsx\OpenWithProgids" Name="MaluOS Slides.Presentation" Value="" Type="string" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\maluos-slides.exe" Value="[#MaluOS SlidesExe]" Type="string" />
      </Component>

      <Component Id="MaluOS SlidesCli">
        <File Id="MaluOS SlidesCliExe" Source="$(var.BinDir)\maluos-slides-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
