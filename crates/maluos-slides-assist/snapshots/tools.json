        "slides": {
          "description": "Instead of markdown: slides in order",
          "items": {
            "properties": {
              "body": {
                "description": "Body text, one paragraph per line, leading tabs indent; or a list of lines",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              },
              "layout": {
                "description": "title, titleAndContent, sectionHeader, twoContent, comparison, titleOnly, blank, contentWithCaption, pictureWithCaption (default from the content)",
