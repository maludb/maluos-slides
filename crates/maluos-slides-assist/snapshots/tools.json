              },
              "notes": {
                "description": "Speaker notes",
                "type": "string"
              },
              "section": {
                "description": "Starts a section with this name before the slide",
                "type": "string"
              },
              "table": {
                "description": "Rows of cells; the first row is the header",
                "items": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
