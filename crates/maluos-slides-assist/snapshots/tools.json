            ],
            "type": "object"
          },
          "type": "array"
        },
        "subtitle": {
          "description": "Subtitle of the title slide",
          "type": "string"
        },
        "theme": {
          "description": "Theme for the deck",
          "enum": [
            "MaluOS Slides",
            "Harbor",
